# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Database (Railway Postgres auto-injects this)
DATABASE_URL=postgresql://localhost:5432/coldcaller

# ---- App authentication (all three are required; the app fails closed) ----

# Initial password for the bootstrap admin account, hashed into the users table
# the first time the app starts against an empty database. It is NOT a shared
# team password — everyone signs in with their own account, and the admin is
# forced to replace this on first login.
#
# Because the seed only runs when the users table is empty (and that check is
# memoised per process), changing this later has no effect. To reset a
# forgotten admin password, use /admin/users as another admin.
APP_PASSWORD=change_me_to_a_long_random_password

# Username for that bootstrap admin. Optional; defaults to "admin".
# ADMIN_USERNAME=admin

# HMAC key for signing session cookies. Generate with: openssl rand -base64 32
# Must be at least 32 characters. Rotating this signs everyone out.
AUTH_SECRET=change_me_generate_with_openssl_rand_base64_32

# Bearer token for the ElevenLabs custom-LLM callback. Generate with:
#   openssl rand -hex 32
# Paste this SAME value into the ElevenLabs agent's Custom LLM "API key" field.
# ElevenLabs labels that field OPENAI_API_KEY in its UI — ignore the label,
# this app calls Claude, not OpenAI.
LLM_WEBHOOK_TOKEN=change_me_generate_with_openssl_rand_hex_32

# Set to 1 only to test a local production build over http (see lib/auth.ts).
# COOKIE_INSECURE=1
